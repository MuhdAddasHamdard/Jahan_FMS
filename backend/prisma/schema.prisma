generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String
  role         String        @default("STUDENT")
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  classes      Class[]       @relation("ClassOwner")
  taughtClasses Class[]      @relation("ClassTeacher")
  students     Student[]     @relation("StudentOwner")
  studentAccount Student?    @relation("StudentAccount")
  feeTypes     FeeType[]
  studentFees  StudentFee[]
  feeInstallments FeeInstallment[]
  receipts     Receipt[]
  refunds      Refund[]
  staff        Staff[]
  salaryPayments SalaryPayment[]
  scheduleEntries ClassSchedule[] @relation("ScheduleAuthor")
  materials    CourseMaterial[]   @relation("MaterialAuthor")
  expenses     Expense[]
}

model InstituteSettings {
  id        Int      @id @default(1)
  name      String   @default("My Institute")
  tagline   String?
  email     String?
  phone     String?
  address   String?
  updatedAt DateTime @updatedAt
}

model Class {
  id          Int              @id @default(autoincrement())
  name        String
  section     String?
  userId      Int
  user        User             @relation("ClassOwner", fields: [userId], references: [id], onDelete: Cascade)
  teacherId   Int?
  teacher     User?            @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  students    Student[]
  schedules   ClassSchedule[]
  materials   CourseMaterial[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([teacherId])
}

model Student {
  id           Int          @id @default(autoincrement())
  admissionNo  String
  name         String
  guardianName String?
  phone        String?
  email        String?
  address      String?
  status       String       @default("ACTIVE")
  userId       Int
  user         User         @relation("StudentOwner", fields: [userId], references: [id], onDelete: Cascade)
  classId      Int?
  class        Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  accountId    Int?         @unique
  account      User?        @relation("StudentAccount", fields: [accountId], references: [id], onDelete: SetNull)
  feePlans     StudentFee[]
  refunds      Refund[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([userId, admissionNo])
  @@index([userId])
  @@index([classId])
}

model FeeType {
  id         Int          @id @default(autoincrement())
  name       String
  amount     Decimal      @default(0) @db.Decimal(12, 2)
  period     String       @default("MONTHLY")
  userId     Int
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plans      StudentFee[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId])
}

model StudentFee {
  id               Int             @id @default(autoincrement())
  studentId        Int
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeTypeId        Int
  feeType          FeeType         @relation(fields: [feeTypeId], references: [id], onDelete: Cascade)
  totalAmount      Decimal         @default(0) @db.Decimal(12, 2)
  installmentCount Int             @default(1)
  userId           Int
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  installments     FeeInstallment[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([studentId, feeTypeId])
  @@index([studentId])
  @@index([userId])
}

model FeeInstallment {
  id            Int        @id @default(autoincrement())
  studentFeeId  Int
  studentFee    StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  amount        Decimal    @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal    @default(0) @db.Decimal(12, 2)
  dueDate       DateTime?
  paidAt        DateTime?
  status        String     @default("PENDING")
  receiptId     Int?
  receipt       Receipt?   @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  userId        Int
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([studentFeeId])
  @@index([userId])
}

model Receipt {
  id           Int              @id @default(autoincrement())
  number       String           @unique
  amount       Decimal          @default(0) @db.Decimal(12, 2)
  paidAt       DateTime         @default(now())
  notes        String?
  userId       Int
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  installments FeeInstallment[]
  createdAt    DateTime         @default(now())

  @@index([userId])
}

model Refund {
  id         Int          @id @default(autoincrement())
  studentId  Int
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount     Decimal      @default(0) @db.Decimal(12, 2)
  reason     String?
  refundedOn DateTime     @default(now())
  userId     Int
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@index([studentId])
  @@index([userId])
}

model Staff {
  id           Int              @id @default(autoincrement())
  staffNo      String
  name         String
  designation  String           @default("TEACHER")
  phone        String?
  email        String?
  salary       Decimal          @default(0) @db.Decimal(12, 2)
  userId       Int
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments     SalaryPayment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([userId, staffNo])
  @@index([userId])
}

model SalaryPayment {
  id          Int        @id @default(autoincrement())
  staffId     Int
  staff       Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  amount      Decimal    @default(0) @db.Decimal(12, 2)
  periodMonth String
  paidOn      DateTime   @default(now())
  notes       String?
  userId      Int
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@unique([staffId, periodMonth])
  @@index([staffId])
  @@index([userId])
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String
  amount      Decimal  @db.Decimal(12, 2)
  paidOn      DateTime @default(now())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model ClassSchedule {
  id        Int      @id @default(autoincrement())
  classId   Int
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  room      String?
  userId    Int
  user      User     @relation("ScheduleAuthor", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([classId])
  @@index([userId])
}

model CourseMaterial {
  id          Int      @id @default(autoincrement())
  classId     Int
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  title       String
  description String?
  link        String?
  userId      Int
  user        User     @relation("MaterialAuthor", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([classId])
  @@index([userId])
}